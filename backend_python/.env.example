# Pejuang Aspal Backend - Environment Variables Example

# Flask / Security
APP_SECRET=change_me_app_secret
JWT_SECRET=change_me_jwt_secret

# Database
DATABASE_URL=sqlite:///pejuang_asal.sqlite

# Socket.IO
SOCKET_CORS_ORIGINS=*
SOCKET_IO_SECRET=change_me_socket_io_secret

# Firebase (optional depending on runtime usage)
FIREBASE_KEY_PATH=backend_python/firebase_key.json

